{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Friday",
  "version": "0.1.0",
  "identifier": "ai.friday.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Friday", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:8000; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all", "macOS": { "infoPlist": "Info.plist" } }
}
